# Copy of root .env.example for backend/.env local setup
APP_ENV=development
FLASK_DEBUG=false
SECRET_KEY=replace_with_32_plus_char_random_session_secret
MOBILE_TOKEN_SECRET=replace_with_32_plus_char_distinct_mobile_token_secret
STRICT_AUTH=true
DB_HOST=postgres
DB_PORT=5432
DB_NAME=psigestor_db
DB_USER=psigestor_user
DB_PASSWORD=replace_with_local_db_password
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8100,http://127.0.0.1:8100,capacitor://localhost,http://localhost,https://localhost
