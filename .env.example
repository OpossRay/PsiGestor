# =============================================================================
# PsiGestor — Safe Environment Configuration Example (.env.example)
# Copy to backend/.env for local development. Never commit real secrets.
# =============================================================================

# Environment: development | staging | production
APP_ENV=development
FLASK_DEBUG=false

# Security Secrets (MUST be distinct, randomly generated >= 32 chars in staging/production)
SECRET_KEY=replace_with_32_plus_char_random_session_secret
MOBILE_TOKEN_SECRET=replace_with_32_plus_char_distinct_mobile_token_secret

# Strict authentication & CSRF enforcement (automatically true in staging/production)
STRICT_AUTH=true
ENFORCE_CSRF_TOKEN=false

# Database connection
# For Neon Managed PostgreSQL (Direct Endpoint with mandatory TLS):
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# For Local Docker PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=psigestor_db
DB_USER=psigestor_user
DB_PASSWORD=replace_with_local_db_password

# CORS & Cookie Settings
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8100,http://127.0.0.1:8100,capacitor://localhost,http://localhost,https://localhost
ALLOW_CAPACITOR_ORIGINS=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_DOMAIN=

# Token Lifetimes & Rate Limiting (RATE_LIMIT_STORAGE: memory | database for multi-instance Render)
RATE_LIMIT_STORAGE=database
MOBILE_ACCESS_TOKEN_TTL_SECONDS=900
MOBILE_REFRESH_TOKEN_TTL_DAYS=14
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_REFRESH_MAX_ATTEMPTS=20
AUTH_REFRESH_WINDOW_SECONDS=60

# Initial Psychologist Bootstrap & Academic Demo Configuration
# INITIAL_PSYCHOLOGIST_EMAIL=psicologia.demo@psigestor.demo
# INITIAL_PSYCHOLOGIST_PASSWORD=replace_with_10_plus_char_secure_password
# INITIAL_PSYCHOLOGIST_NAME=Lic. Psicología Demo
# DEMO_STUDENT_PASSWORD=replace_with_10_plus_char_secure_password
